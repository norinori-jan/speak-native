[{"id":"quick01","ic":"💬","n":"よく使う短い一言・1（あいさつ・お礼・お願い 601〜610）","hint":"Ten mini conversations built from short phrases people use all day, such as greetings, thanks, requests, apologies and polite replies","level":4,"keywords":["everyday","listening","basics"],"d":[{"t":"👋 601｜会ったとき：Greetings","l":[{"sp":0,"en":"Hi! How\u0027s it going?","jp":"やあ！ 調子はどう？"},{"sp":1,"en":"Pretty good. You?","jp":"まあまあ。あなたは？"},{"sp":0,"en":"Can\u0027t complain.","jp":"文句なしだよ。"},{"sp":1,"en":"Long time no see!","jp":"久しぶり！"},{"sp":0,"en":"I know! It\u0027s been ages.","jp":"ほんとに！ 何年ぶりだろう。"},{"sp":1,"en":"What have you been up to?","jp":"最近どうしてた？"},{"sp":0,"en":"Just work, mostly.","jp":"ほとんど仕事だよ。"},{"sp":1,"en":"Same here. Let\u0027s catch up soon.","jp":"私も。近いうちに話そう。"}]},{"t":"🙏 602｜お礼を言う：Saying Thanks","l":[{"sp":0,"en":"Here\u0027s your coffee.","jp":"コーヒーどうぞ。"},{"sp":1,"en":"Thanks a lot!","jp":"どうもありがとう！"},{"sp":0,"en":"No problem.","jp":"どういたしまして。"},{"sp":1,"en":"I really appreciate it.","jp":"本当に感謝してる。"},{"sp":0,"en":"Don\u0027t mention it.","jp":"気にしないで。","note":"元の形: do not／聞こえ方: ドン／使う場面:否定・禁止する時"},{"sp":1,"en":"You\u0027re so kind.","jp":"ご親切に。"},{"sp":0,"en":"It\u0027s my pleasure.","jp":"喜んで。"},{"sp":1,"en":"Thanks again.","jp":"重ねてありがとう。"}]},{"t":"🤲 603｜お願いする：Asking for Favors","l":[{"sp":0,"en":"Could you do me a favor?","jp":"お願いをひとつ聞いてもらえる？","note":"元の形: could you／聞こえ方: クッジュ／使う場面:丁寧に頼む時"},{"sp":1,"en":"Sure. What is it?","jp":"いいよ。何？"},{"sp":0,"en":"Can you hold this for a second?","jp":"これをちょっと持っててくれる？"},{"sp":1,"en":"Of course.","jp":"もちろん。"},{"sp":0,"en":"Would you mind opening the door?","jp":"ドアを開けてもらえますか。","note":"元の形: would you／聞こえ方: ウッジュ／使う場面:丁寧に聞く時"},{"sp":1,"en":"Not at all.","jp":"全然かまいません。"},{"sp":0,"en":"Thanks. I owe you one.","jp":"ありがとう。借りができたね。"},{"sp":1,"en":"Anytime.","jp":"いつでも。"}]},{"t":"😅 604｜謝る：Saying Sorry","l":[{"sp":0,"en":"Oh, sorry! I bumped into you.","jp":"あ、ごめん！ ぶつかっちゃった。"},{"sp":1,"en":"That\u0027s okay. No harm done.","jp":"いいよ。何ともないから。","note":"元の形: that\u0027s／聞こえ方: ザッツ／使う場面:それはと言う時"},{"sp":0,"en":"I wasn\u0027t looking.","jp":"見てなかったの。"},{"sp":1,"en":"It happens.","jp":"よくあることだよ。"},{"sp":0,"en":"Sorry I\u0027m late.","jp":"遅れてごめん。"},{"sp":1,"en":"Don\u0027t worry about it.","jp":"気にしないで。"},{"sp":0,"en":"I\u0027ll make it up to you.","jp":"埋め合わせするね。","note":"元の形: I\u0027ll／聞こえ方: アイル／使う場面:これからやると決める時"},{"sp":1,"en":"There\u0027s no need.","jp":"その必要はないよ。"}]},{"t":"👍 605｜賛成・同感：Agreeing","l":[{"sp":0,"en":"Let\u0027s order pizza tonight.","jp":"今夜はピザを頼もう。"},{"sp":1,"en":"Sounds good to me.","jp":"いいね。"},{"sp":0,"en":"Should we get two?","jp":"2枚頼む？"},{"sp":1,"en":"I think one is enough.","jp":"1枚で足りると思う。"},{"sp":0,"en":"You\u0027re right.","jp":"そうだね。"},{"sp":1,"en":"Anything on it?","jp":"何かのせる？"},{"sp":0,"en":"Just cheese.","jp":"チーズだけでいい。"},{"sp":1,"en":"Perfect. I\u0027ll call now.","jp":"完璧。いま電話するね。","note":"元の形: I\u0027ll／聞こえ方: アイル／使う場面:これからやると決める時"}]},{"t":"🤔 606｜やんわり反対：Disagreeing Gently","l":[{"sp":0,"en":"I think we should leave now.","jp":"もう出た方がいいと思う。"},{"sp":1,"en":"I\u0027m not so sure.","jp":"どうかな。","note":"元の形: I\u0027m／聞こえ方: アイム／使う場面:自分の状態を言う時"},{"sp":0,"en":"Why not?","jp":"どうして？"},{"sp":1,"en":"It\u0027s still early.","jp":"まだ早いから。"},{"sp":0,"en":"That\u0027s true, but traffic\u0027s bad.","jp":"それはそうだけど、道が混んでる。","note":"元の形: that\u0027s／聞こえ方: ザッツ／使う場面:それはと言う時"},{"sp":1,"en":"Good point.","jp":"もっともだね。"},{"sp":0,"en":"Let\u0027s compromise. Ten minutes?","jp":"折衷しよう。10分後は？"},{"sp":1,"en":"Okay, deal.","jp":"よし、決まり。"}]},{"t":"🆘 607｜助けを求める：Asking for Help","l":[{"sp":0,"en":"Excuse me, can you help me?","jp":"すみません、助けてもらえますか。"},{"sp":1,"en":"Sure. What do you need?","jp":"はい。何が必要？","note":"元の形: what do you／聞こえ方: ワッドゥユー／使う場面:何をするかたずねる時"},{"sp":0,"en":"I can\u0027t find the exit.","jp":"出口が見つからなくて。"},{"sp":1,"en":"It\u0027s right over there.","jp":"あそこですよ。"},{"sp":0,"en":"Where exactly?","jp":"正確にはどこ？"},{"sp":1,"en":"Past the elevators, on the left.","jp":"エレベーターの先、左側。"},{"sp":0,"en":"Got it. Thanks!","jp":"分かった。ありがとう！"},{"sp":1,"en":"No worries.","jp":"気にしないで。"}]},{"t":"💭 608｜つなぎの言葉：Fillers and Hedges","l":[{"sp":0,"en":"So, what do you think?","jp":"それで、どう思う？","note":"元の形: what do you／聞こえ方: ワッドゥユー／使う場面:何をするかたずねる時"},{"sp":1,"en":"Well, to be honest, I\u0027m not sure.","jp":"うーん、正直、分からない。","note":"元の形: I\u0027m／聞こえ方: アイム／使う場面:自分の状態を言う時"},{"sp":0,"en":"You know, it\u0027s a big decision.","jp":"ほら、大きな決断だから。"},{"sp":1,"en":"I mean, we have time.","jp":"つまり、時間はあるし。"},{"sp":0,"en":"Actually, I\u0027d like to wait.","jp":"実は、待ちたいな。"},{"sp":1,"en":"Fair enough.","jp":"もっともだね。"},{"sp":0,"en":"Let\u0027s sleep on it.","jp":"ひと晩考えよう。"},{"sp":1,"en":"Sounds like a plan.","jp":"それがいいね。"}]},{"t":"🎁 609｜申し出る・すすめる：Offering","l":[{"sp":0,"en":"Would you like some tea?","jp":"お茶はいかがですか。","note":"元の形: would you／聞こえ方: ウッジュ／使う場面:丁寧に聞く時"},{"sp":1,"en":"Yes, please.","jp":"はい、お願いします。"},{"sp":0,"en":"Want some sugar?","jp":"砂糖はいる？"},{"sp":1,"en":"No, thanks. I\u0027m fine.","jp":"いいえ、大丈夫。"},{"sp":0,"en":"How about a cookie?","jp":"クッキーはどう？","note":"元の形: how about／聞こえ方: ハウアバウ／使う場面:提案する時"},{"sp":1,"en":"Oh, I\u0027d love one.","jp":"ああ、いただきたい。"},{"sp":0,"en":"Help yourself.","jp":"自由にどうぞ。"},{"sp":1,"en":"You\u0027re too kind.","jp":"優しすぎるよ。"}]},{"t":"👋 610｜別れのあいさつ：Saying Goodbye","l":[{"sp":0,"en":"Well, I should get going.","jp":"さて、そろそろ行かなきゃ。"},{"sp":1,"en":"Already? Stay a little longer.","jp":"もう？ もう少しいて。"},{"sp":0,"en":"I wish I could, but I\u0027m busy.","jp":"そうしたいけど、忙しくて。","note":"元の形: I\u0027m／聞こえ方: アイム／使う場面:自分の状態を言う時"},{"sp":1,"en":"Okay. It was great seeing you.","jp":"そっか。会えてよかった。"},{"sp":0,"en":"You too. Take care.","jp":"あなたも。気をつけて。"},{"sp":1,"en":"Say hi to your family.","jp":"ご家族によろしくね。"},{"sp":0,"en":"Will do. See you soon!","jp":"そうする。またね！"},{"sp":1,"en":"Bye! Have a good one.","jp":"じゃあね！ いい一日を。"}]}]}]
