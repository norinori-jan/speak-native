[{"id":"story09","ic":"👂","n":"灯りのつく階段 第9話・耳で覚える英語（物語で学ぶ英会話 907〜913）","hint":"Seven scenes from a short story: learning English by ear, listening to the pauses between words, rain on a rooftop, sharing one pair of earphones on the stairs, and saying thank you in English. For English study about listening, repeating and shadowing","level":4,"keywords":["everyday","listening","basics"],"d":[{"t":"🌧️ 907｜雨の夜：A Rainy Night","l":[{"sp":0,"en":"It\u0027s raining hard.","jp":"雨が強いですね。"},{"sp":1,"en":"You can hear it on the roof.","jp":"屋根に当たる音が聞こえる。"},{"sp":0,"en":"Does it bother you?","jp":"気になりますか？"},{"sp":1,"en":"No. I like it.","jp":"いいえ。好きです。"},{"sp":0,"en":"It sounds like a slow drum.","jp":"ゆっくりしたドラムみたい。"},{"sp":1,"en":"Tea?","jp":"お茶は？"},{"sp":0,"en":"Yes, please.","jp":"はい、お願いします。"},{"sp":1,"en":"Thank you.","jp":"ありがとう。"}]},{"t":"📄 908｜音だけ欲しい：Only the Sound","l":[{"sp":0,"en":"Could you read it aloud?","jp":"声に出して読んでいただけますか？"},{"sp":1,"en":"It\u0027s in English.","jp":"英語だよ。"},{"sp":0,"en":"I don\u0027t need the meaning.","jp":"意味はいりません。"},{"sp":1,"en":"Then what do you need?","jp":"じゃあ何が欲しいの？","note":"元の形: what do you／聞こえ方: ワッドゥユー／使う場面:何をするかたずねる時"},{"sp":0,"en":"Just the sound.","jp":"音だけです。"},{"sp":1,"en":"I learn by ear.","jp":"私は耳で覚えるんです。","note":"表現: learn by ear = 耳で覚える"},{"sp":0,"en":"Listen, then.","jp":"では、聴きなさい。"},{"sp":1,"en":"Ready.","jp":"はい。"}]},{"t":"🔁 909｜繰り返す：Say It Again","l":[{"sp":0,"en":"Repeat after me.","jp":"私の後に続けて。","note":"用語: repeat after me / shadowing = 後について言う練習"},{"sp":1,"en":"I made a mistake.","jp":"間違えました。"},{"sp":0,"en":"Again. Same sentence, same speed.","jp":"もう一度。同じ文、同じ速さで。"},{"sp":1,"en":"Better?","jp":"良くなりました？"},{"sp":0,"en":"A little.","jp":"少しね。"},{"sp":1,"en":"You don\u0027t correct me?","jp":"直してくれないんですか？","note":"元の形: do not／聞こえ方: ドン／使う場面:否定・禁止する時"},{"sp":0,"en":"I just say it again.","jp":"もう一度言うだけだ。"},{"sp":1,"en":"That helps more.","jp":"その方が助かります。"}]},{"t":"🤫 910｜語と語の間：Between the Words","l":[{"sp":0,"en":"Where should I listen?","jp":"どこを聴けばいいですか？"},{"sp":1,"en":"Not to the words.","jp":"語ではなく。"},{"sp":0,"en":"To what?","jp":"何を？"},{"sp":1,"en":"To the space between them.","jp":"語と語の間を。","note":"表現: the space between = 間"},{"sp":0,"en":"The silence?","jp":"静けさ？"},{"sp":1,"en":"Yes. English lives there too.","jp":"そう。英語はそこにも住んでいる。"},{"sp":0,"en":"This building has that too.","jp":"このビルにも、それがありますね。"},{"sp":1,"en":"It does.","jp":"そうだね。"}]},{"t":"🎧 911｜イヤホンを半分：One Earphone Each","l":[{"sp":0,"en":"Here. These are old, but the sound is good.","jp":"これ、どうぞ。古いけど音はいい。"},{"sp":1,"en":"Thanks.","jp":"ありがとう。"},{"sp":0,"en":"One each?","jp":"一つずつにしますか？"},{"sp":1,"en":"...Okay.","jp":"……いいよ。"},{"sp":0,"en":"What are we listening to?","jp":"何を聴いているの？"},{"sp":1,"en":"Just English radio.","jp":"英語のラジオ。"},{"sp":0,"en":"We don\u0027t have to talk.","jp":"話さなくていい。","note":"元の形: have to／聞こえ方: ハフタ／使う場面:しなければと言う時"},{"sp":1,"en":"No. We don\u0027t.","jp":"うん。話さなくていい。","note":"元の形: do not／聞こえ方: ドン／使う場面:否定・禁止する時"}]},{"t":"🙏 912｜ありがとうございます：Thank You","l":[{"sp":0,"en":"Thank you.","jp":"ありがとうございます。"},{"sp":1,"en":"No problem.","jp":"いえ。"},{"sp":0,"en":"That was ten minutes.","jp":"十分でしたね。"},{"sp":1,"en":"It felt short.","jp":"短く感じた。"},{"sp":0,"en":"Same time tomorrow?","jp":"明日も同じ時間？"},{"sp":1,"en":"If you want.","jp":"よければ。"},{"sp":0,"en":"I do.","jp":"そうしたい。"},{"sp":1,"en":"Good night.","jp":"おやすみなさい。"}]},{"t":"🪟 913｜窓越しの一言：One Line Through the Window","l":[{"sp":0,"en":"Thank you for today.","jp":"今日もありがとうございました。"},{"sp":1,"en":"Say it in English.","jp":"英語で言ってごらん。"},{"sp":0,"en":"Thank you for today.","jp":"Thank you for today."},{"sp":1,"en":"Good.","jp":"良い。"},{"sp":0,"en":"Only that?","jp":"それだけですか？"},{"sp":1,"en":"It was good enough.","jp":"十分だった。"},{"sp":0,"en":"Good night.","jp":"おやすみなさい。"},{"sp":1,"en":"Good night.","jp":"おやすみなさい。"}]}]}]
